# Los dos primeros comandos son necesarios para que Gretl guarde los resultados de la práctica en el directorio de trabajo
# al ejecutar lo siguiente desde un terminal (use los nombres y ruta que correspondan)
#
#    DIRECTORIO="Nombre_Directorio_trabajo" gretlcli -b ruta/nombre_fichero_de_la_practica.inp
#
# Si esto no le funciona en su sistema, comente las siguientes dos líneas y sitúese en el directorio de trabajo de gretl
# que corresponda (configure dicho directorio de trabajo desde la ventana principal de Gretl).

string directory = getenv("DIRECTORIO")
set workdir "@directory"

set verbose off

open hprice2.gdt --quiet

ols price const rooms --quiet
scalar beta1_verdadero = $coeff(const)          # beta_1 "verdadero"
scalar beta2_verdadero = $coeff(rooms)          # beta_2 "verdadero"
scalar sigma   = sqrt($ess/$df)         # sigma "verdadera" (raiz de la cuasivarianza)
scalar n       = $nobs
scalar Sxx     = sum((rooms - mean(rooms))^2)
scalar Var_b2_en_X_observada = sigma^2 / Sxx          # formula de la leccion 11

outfile --quiet mundoArtificial.txt
    printf "n              = %d\n", n
    printf "beta_1         = %.4f\n", beta1_verdadero
    printf "beta_2         = %.4f\n", beta2_verdadero
    printf "sigma          = %.4f\n", sigma
    printf "Sxx            = %.4f\n", Sxx
    printf "Var[b2 | X]    = sigma^2/Sxx = %.4f\n", Var_b2_en_X_observada
    printf "error estandar = %.4f\n", sqrt(Var_b2_en_X_observada)
end outfile

outfile --quiet unaReplica.txt
    set seed 20261030                       # para que el resultado sea reproducible
    
    series u_sim = normal(0, sigma)                    # perturbacion nueva
    series y_sim = beta1_verdadero + beta2_verdadero*rooms + u_sim     # muestra simulada
    
    ols y_sim const rooms
    printf "\nbeta_2 verdadero  = %.4f\n", beta2_verdadero
    printf "beta_2 estimado   = %.4f\n", $coeff(rooms)
    printf "diferencia        = %.4f\n", $coeff(rooms) - beta2_verdadero
end outfile

scalar R = 2000                         # numero de replicas

set seed 20261030
loop R --progressive --quiet
    series u_sim = normal(0, sigma)
    series y_sim = beta1_verdadero + beta2_verdadero*rooms + u_sim
    ols y_sim const rooms --quiet
    scalar beta1_estimado = $coeff(const)
    scalar beta2_estimado = $coeff(rooms)
    store "@workdir/replicas.gdt" beta1_estimado beta2_estimado
endloop

outfile --quiet bucle.txt
    printf "Hecho: %d replicas guardadas en replicas.gdt\n", R
end outfile

outfile --quiet analisisReplicas.txt
    printf "=== LO QUE PREDICE LA LECCION 11 ===\n"
    printf "beta_2 verdadero               = %.4f\n", beta2_verdadero
    printf "Var[b2 | X] en la X observada  = %.4f\n", Var_b2_en_X_observada
    printf "error estandar                 = %.4f\n\n", sqrt(Var_b2_en_X_observada)
end outfile

open "@workdir/replicas.gdt" --quiet
outfile --quiet empiricoReplicas.txt
    printf "=== LO QUE SALE DE %d REPLICAS SIMULADAS ===\n", $nobs
    printf "media de beta2_estimado        = %.4f\n", mean(beta2_estimado)
    printf "varianza de beta2_estimado     = %.4f\n", sum((beta2_estimado-mean(beta2_estimado))^2)/$nobs
    printf "desv. tipica de beta2_estimado = %.4f\n", sqrt(sum((beta2_estimado-mean(beta2_estimado))^2)/$nobs)
end outfile

freq beta2_estimado --normal --plot="@workdir/histograma_b2.png"

open hprice2.gdt --quiet                  # recuperamos los regresores
ols price const rooms --quiet
scalar sigma = sqrt($ess/$df)

outfile --quiet matrizVCV.txt
    matrix X      = {const, rooms}
    matrix inv_XtX = invpd(X'X)
    matrix Var_beta_en_X_observada   = sigma^2 * inv_XtX
    printf "Matriz sigma^2 (X'X)^{-1} predicha por la leccion 11:\n"
    print Var_beta_en_X_observada
end outfile

open "@workdir/replicas.gdt" --quiet
outfile --quiet matrizEmpirica.txt
    matrix betas_replicas = {beta1_estimado}~{beta2_estimado}
    matrix Var_beta_replicas = mcov(betas_replicas)
    printf "\nMatriz de varianzas y covarianzas EMPIRICA de las replicas:\n"
    print Var_beta_replicas
end outfile
