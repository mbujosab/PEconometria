# Los dos primeros comandos son necesarios para que Gretl guarde los resultados de la práctica en el directorio de trabajo
# al ejecutar lo siguiente desde un terminal (use los nombres y ruta que correspondan)
#
#    DIRECTORIO="Nombre_Directorio_trabajo" gretlcli -b ruta/nombre_fichero_de_la_practica.inp
#
# Si esto no le funciona en su sistema, comente las siguientes dos líneas y sitúese en el directorio de trabajo de gretl
# que corresponda (configure dicho directorio de trabajo desde la ventana principal de Gretl).

string directory = getenv("DIRECTORIO")
set workdir "@directory"

set verbose off

open hprice2.gdt --quiet
scalar b1  = 20000
scalar sig = 5000
scalar R   = 2000
scalar Fc506 = critical(F, 3, 502, 0.05)
set seed 20261119
loop R --progressive --quiet
    series u = normal(0, sig)
    series y = b1 + u                       # H0 cierta: rooms, nox y stratio no intervienen
    ols y const rooms nox stratio --quiet
    scalar Fst   = $Fstat
    scalar SRC   = $ess
    scalar SEC   = $ess*$rsq/(1-$rsq)      # SEC = STC - SRC, con STC = SRC/(1-R^2)
    scalar numer = SEC/3
    scalar denom = SRC/502
    store "@workdir/replicasF.gdt" Fst numer denom
endloop
open "@workdir/replicasF.gdt" --quiet
scalar sig = 5000
scalar Fc506 = critical(F, 3, 502, 0.05)
outfile --quiet bajoH0.txt
    printf "H0 cierta, n = 506, k = 4, %d replicas, sigma^2 = %.3e\n", $nobs, sig^2
    printf "media de SEC/(k-1) = %.4e\n", mean(numer)
    printf "media de SRC/(n-k) = %.4e\n", mean(denom)
    printf "media de F         = %.3f    mediana = %.3f\n", mean(Fst), median(Fst)
    printf "fraccion de F > F_c(3,502) = %.3f = %.4f   (nominal 0,05)\n", Fc506, mean(Fst > Fc506)
    printf "cuantil empirico 95%% de F  = %.3f   (F_c = %.3f)\n", quantile(Fst, 0.95), Fc506
end outfile
freq Fst --plot="@workdir/histF.png"

# --- n = 20 ---
open hprice2.gdt --quiet
scalar b1  = 20000
scalar sig = 5000
scalar R   = 2000
set seed 20261119
smpl 20 --random
scalar Fc20 = critical(F, 3, 16, 0.05)
set seed 20261119
loop R --progressive --quiet
    series u = normal(0, sig)
    series y = b1 + u
    ols y const rooms nox stratio --quiet
    scalar F20 = $Fstat
    store "@workdir/replicasF20.gdt" F20
endloop
open "@workdir/replicasF20.gdt" --quiet
scalar Fc20 = critical(F, 3, 16, 0.05)
outfile --quiet n20.txt
    printf "H0 cierta, n = 20 (n-k = 16), %d replicas\n", $nobs
    printf "media de F = %.3f    mediana = %.3f    cuantil 95%% = %.3f   (F_c(3,16) = %.3f)\n", mean(F20), median(F20), quantile(F20, 0.95), Fc20
    printf "fraccion de F > F_c(3,16) = %.4f   (nominal 0,05)\n", mean(F20 > Fc20)
    printf "fraccion de F > F_c(3,502) = %.4f  <- si se usara el valor critico de n = 506\n", mean(F20 > critical(F, 3, 502, 0.05))
end outfile
freq F20 --plot="@workdir/histF20.png"

# --- H0 falsa por poco: n = 20 y n = 506 ---
open hprice2.gdt --quiet
scalar b1 = 20000
scalar sig = 5000
scalar R = 2000
scalar bn = -800                         # efecto pequeno de nox; rooms y stratio siguen sin intervenir
outfile --quiet deteccion.txt
    set seed 20261119
    smpl 20 --random
    scalar Fc = critical(F, 3, $nobs-4, 0.05)
    set seed 20261119
    scalar rech = 0
    loop R --quiet
        series u = normal(0, sig)
        series y = b1 + bn*nox + u
        ols y const rooms nox stratio --quiet
        rech += ($Fstat > Fc)
    endloop
    printf "H0 falsa (beta_nox = %d), n = %3d: rechazos = %.3f\n", bn, $nobs, rech/R
    smpl full
    scalar Fc = critical(F, 3, $nobs-4, 0.05)
    set seed 20261119
    scalar rech = 0
    loop R --quiet
        series u = normal(0, sig)
        series y = b1 + bn*nox + u
        ols y const rooms nox stratio --quiet
        rech += ($Fstat > Fc)
    endloop
    printf "H0 falsa (beta_nox = %d), n = %3d: rechazos = %.3f\n", bn, $nobs, rech/R
end outfile
