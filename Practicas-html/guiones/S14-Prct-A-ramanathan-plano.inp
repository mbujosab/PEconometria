# Guion auxiliar: genera la figura estática del plano de regresión que
# aparece en el texto de la práctica. No forma parte de la práctica:
# en clase, el plano se dibuja desde el menú de Gretl.
string directory = getenv("DIRECTORIO")
set workdir "@directory"
open data4-1.gdt --quiet
ols price const sqft bedrms --quiet
matrix b = $coeff
series yh = $yhat
set force_decpoint on
outfile --quiet plano.plt
printf "set xlabel 'sqft'\nset ylabel 'bedrms'\nset zlabel 'price' rotate\n"
printf "set view 62,300\nset samples 12\nset isosamples 12\nset key off\nset xyplane 0\n"
printf "set xrange [1000:3100]\nset yrange [2.8:4.2]\nset ytics 1\nset border 4095 lc rgb '#888888'\n"
printf "set style arrow 1 nohead lw 1.5 lc rgb 'red'\n"
printf "f(x,y) = %.10g + %.10g*x + %.10g*y\n", b[1], b[2], b[3]
printf "splot f(x,y) with lines lc rgb '#bbbbbb', '-' using 1:2:3 with points pt 7 lc rgb 'blue', '-' using 1:2:3:(0):(0):4 with vectors arrowstyle 1\n"
loop i=1..$nobs
  printf "%g %g %g\n", sqft[i], bedrms[i], price[i]
endloop
printf "e\n"
loop i=1..$nobs
  printf "%g %g %g %g\n", sqft[i], bedrms[i], yh[i], price[i]-yh[i]
endloop
printf "e\n"
end outfile
set force_decpoint off
string fin = getenv("DIRECTORIO") ~ "/plano.plt"
gnuplot --input=@fin --output="plano_price_sqft_bedrms.png"
