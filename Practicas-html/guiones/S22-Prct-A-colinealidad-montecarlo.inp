# Los dos primeros comandos son necesarios para que Gretl guarde los resultados de la práctica en el directorio de trabajo
# al ejecutar lo siguiente desde un terminal (use los nombres y ruta que correspondan)
#
#    DIRECTORIO="Nombre_Directorio_trabajo" gretlcli -b ruta/nombre_fichero_de_la_practica.inp
#
# Si esto no le funciona en su sistema, comente las siguientes dos líneas y sitúese en el directorio de trabajo de gretl
# que corresponda (configure dicho directorio de trabajo desde la ventana principal de Gretl).

string directory = getenv("DIRECTORIO")
set workdir "@directory"

set verbose off

nulldata 100
scalar n   = $nobs
scalar b1  = 1
scalar b2  = 1
scalar b3  = 1
scalar sig = 1
scalar R   = 2000
scalar tc  = critical(t, n-3, 0.025)
matrix rhos = {0, 0.9, 0.99, 0.999}
outfile --quiet montecarlo.txt
    printf "n = %d, beta = (1, 1, 1), sigma = 1, %d replicas por cada rho\n\n", n, R
    printf "%7s %8s %8s %10s %10s %10s %10s %8s %8s %8s\n", "rho", "corr", "VIF", "var(b2)", "teorica", "cov(b2,b3)", "var(b2+b3)", "SRC", "R2", "%|t|>tc"
    loop j=1..4 --quiet
        scalar rho = rhos[j]
        set seed 2026
        series z1 = normal()
        series z2 = normal()
        series x2 = z1
        series x3 = rho*z1 + sqrt(1-rho^2)*z2
        ols x2 const x3 --quiet
        scalar longPropia2 = sqrt($ess)                 # || parte propia de x2 ||
        scalar varTeorica  = sig^2/longPropia2^2         # sigma^2 / ||x2 propia||^2
        matrix B = zeros(R, 2)
        matrix S = zeros(R, 2)
        scalar signif = 0
        set seed 20261120
        loop i=1..R --quiet
            series u = normal(0, sig)
            series y = b1 + b2*x2 + b3*x3 + u
            ols y const x2 x3 --quiet
            B[i,] = {$coeff(x2), $coeff(x3)}
            S[i,] = {$ess, $rsq}
            signif += abs($coeff(x2)/$stderr(x2)) > tc
        endloop
        matrix V = mcov(B)
        printf "%7.3f %8.4f %8.1f %10.4f %10.4f %10.4f %10.4f %8.2f %8.4f %8.3f\n", rho, corr(x2, x3), 1/(1-corr(x2,x3)^2), V[1,1], varTeorica, V[1,2], V[1,1]+V[2,2]+2*V[1,2], meanc(S[,1]), meanc(S[,2]), signif/R
        if j == 1
            matrix B0 = B
        elif j == 3
            matrix B99 = B
        endif
    endloop
end outfile

# Histogramas de b2 con rho = 0 y con rho = 0,99 (mismos ejes)
nulldata R --preserve
series b2_rho0  = B0[,1]
series b2_rho99 = B99[,1]
series b3_rho99 = B99[,2]
series suma_rho99 = b2_rho99 + b3_rho99
outfile --quiet histogramas.txt
    printf "rho = 0     : b2 medio = %.4f   desv. tipica = %.4f   min = %.3f   max = %.3f\n", mean(b2_rho0), sd(b2_rho0), min(b2_rho0), max(b2_rho0)
    printf "rho = 0,99  : b2 medio = %.4f   desv. tipica = %.4f   min = %.3f   max = %.3f\n", mean(b2_rho99), sd(b2_rho99), min(b2_rho99), max(b2_rho99)
    printf "rho = 0,99  : b2 + b3 medio = %.4f   desv. tipica = %.4f\n", mean(suma_rho99), sd(suma_rho99)
    printf "correlacion entre b2 y b3 con rho = 0,99: %.4f\n", corr(b2_rho99, b3_rho99)
end outfile
freq b2_rho0 --plot="@workdir/histRho0.png"
freq b2_rho99 --plot="@workdir/histRho99.png"
gnuplot b3_rho99 b2_rho99 --output="@workdir/nubeRho99.png"
