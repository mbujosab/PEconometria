# Los dos primeros comandos son necesarios para que Gretl guarde los resultados de la práctica en el directorio de trabajo
# al ejecutar lo siguiente desde un terminal (use los nombres y ruta que correspondan)
#
#    DIRECTORIO="Nombre_Directorio_trabajo" gretlcli -b ruta/nombre_fichero_de_la_practica.inp
#
# Si esto no le funciona en su sistema, comente las siguientes dos líneas y sitúese en el directorio de trabajo de gretl
# que corresponda (configure dicho directorio de trabajo desde la ventana principal de Gretl).
#
# Cada actividad guarda su salida en un fichero de texto (el que el documento de la práctica
# muestra) y la imprime a continuación en pantalla con readfile(), de modo que al ejecutar
# este guion se ve lo mismo que en el documento.

string directory = getenv("DIRECTORIO")
set workdir "@directory"

set verbose off

nulldata 100
scalar n   = $nobs
scalar beta1_verdadero  = 1
scalar beta2_verdadero  = 1
scalar beta3_verdadero  = 1
scalar sigma = 1
scalar R   = 2000
scalar tc  = critical(t, n-3, 0.025)
matrix rhos = {0, 0.9, 0.99, 0.999}
outfile --quiet montecarlo.txt
    printf "n = %d, beta = (1, 1, 1), sigma = 1, %d replicas por cada rho\n\n", n, R
    printf "%7s %8s %8s %10s %10s %10s %10s %10s %8s %8s %8s\n", "rho", "corr", "VIF", "var(b2)", "formula", "cov(b2,b3)", "var(b2+b3)", "var(b2-b3)", "SRC", "R2", "%|t|>tc"
    loop j=1..4 --quiet
        scalar rho = rhos[j]
        set seed 2026
        series z1 = normal()
        series z2 = normal()
        series x2 = z1
        series x3 = rho*z1 + sqrt(1-rho^2)*z2
        ols x2 const x3 --quiet
        scalar longitud_propia_x2 = sqrt($ess)                 # || parte propia de x2 ||
        scalar Var_b2_en_X_observada  = sigma^2/longitud_propia_x2^2         # sigma^2 / ||x2 propia||^2
        matrix estimaciones = zeros(R, 2)
        matrix SRC_y_R2 = zeros(R, 2)
        scalar rechazos = 0
        set seed 20261120
        loop i=1..R --quiet
            series u = normal(0, sigma)
            series y = beta1_verdadero + beta2_verdadero*x2 + beta3_verdadero*x3 + u
            ols y const x2 x3 --quiet
            estimaciones[i,] = {$coeff(x2), $coeff(x3)}
            SRC_y_R2[i,] = {$ess, $rsq}
            rechazos += abs($coeff(x2)/$stderr(x2)) > tc
        endloop
        matrix Cov_estimaciones = mcov(estimaciones)
        printf "%7.3f %8.4f %8.1f %10.4f %10.4f %10.4f %10.4f %10.4f %8.2f %8.4f %8.3f\n", rho, corr(x2, x3), 1/(1-corr(x2,x3)^2), Cov_estimaciones[1,1], Var_b2_en_X_observada, Cov_estimaciones[1,2], Cov_estimaciones[1,1]+Cov_estimaciones[2,2]+2*Cov_estimaciones[1,2], Cov_estimaciones[1,1]+Cov_estimaciones[2,2]-2*Cov_estimaciones[1,2], meanc(SRC_y_R2[,1]), meanc(SRC_y_R2[,2]), rechazos/R
        if j == 1
            matrix estimaciones_rho0 = estimaciones
        elif j == 3
            matrix estimaciones_rho99 = estimaciones
        endif
    endloop
end outfile
printf "%s", readfile("montecarlo.txt")   # en pantalla

# Histogramas de las estimaciones de beta2 con rho = 0 y con rho = 0,99 (mismos ejes)
nulldata R --preserve
series beta2_estimado_rho0  = estimaciones_rho0[,1]
series beta2_estimado_rho99 = estimaciones_rho99[,1]
series beta3_estimado_rho99 = estimaciones_rho99[,2]
series suma_estimados_rho99 = beta2_estimado_rho99 + beta3_estimado_rho99
outfile --quiet histogramas.txt
    printf "rho = 0     : b2 medio = %.4f   desv. tipica = %.4f   min = %.3f   max = %.3f\n", mean(beta2_estimado_rho0), sd(beta2_estimado_rho0), min(beta2_estimado_rho0), max(beta2_estimado_rho0)
    printf "rho = 0,99  : b2 medio = %.4f   desv. tipica = %.4f   min = %.3f   max = %.3f\n", mean(beta2_estimado_rho99), sd(beta2_estimado_rho99), min(beta2_estimado_rho99), max(beta2_estimado_rho99)
    printf "rho = 0,99  : b2 + b3 medio = %.4f   desv. tipica = %.4f\n", mean(suma_estimados_rho99), sd(suma_estimados_rho99)
    printf "correlacion entre b2 y b3 con rho = 0,99: %.4f\n", corr(beta2_estimado_rho99, beta3_estimado_rho99)
end outfile
printf "%s", readfile("histogramas.txt")   # en pantalla

freq beta2_estimado_rho0 --plot="@workdir/histRho0.png"
freq beta2_estimado_rho99 --plot="@workdir/histRho99.png"
gnuplot beta3_estimado_rho99 beta2_estimado_rho99 --output=display                    # en pantalla
gnuplot beta3_estimado_rho99 beta2_estimado_rho99 --output="@workdir/nubeRho99.png"   # guardada para el documento
