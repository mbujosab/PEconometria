# Los dos primeros comandos son necesarios para que Gretl guarde los resultados de la práctica en el directorio de trabajo
# al ejecutar lo siguiente desde un terminal (use los nombres y ruta que correspondan)
#
#    DIRECTORIO="Nombre_Directorio_trabajo" gretlcli -b ruta/nombre_fichero_de_la_practica.inp
#
# Si esto no le funciona en su sistema, comente las siguientes dos líneas y sitúese en el directorio de trabajo de gretl
# que corresponda (configure dicho directorio de trabajo desde la ventana principal de Gretl).

string directory = getenv("DIRECTORIO")
set workdir "@directory"

set verbose off

open hprice2.gdt --quiet

ols price const rooms --quiet
scalar beta1_verdadero = $coeff(const)
scalar beta2_verdadero = $coeff(rooms)
scalar sigma   = sqrt($ess/$df)

matrix pob_rooms = {rooms}              # las 506 viviendas: la "poblacion" del regresor
scalar N         = $nobs
scalar var_rooms = sum((rooms-mean(rooms))^2)/N
outfile --quiet preparacion.txt
    printf "Poblacion del regresor (las %d viviendas de hprice2): media = %.4f   varianza = %.4f\n", N, mean(rooms), var_rooms
    
    set seed 160
    smpl 12 --random                        # doce viviendas elegidas AL AZAR
    scalar Sxx_obs  = sum((rooms-mean(rooms))^2)
    scalar Var_b2_en_X_observada = sigma^2 / Sxx_obs
    
    printf "\nSubmuestra observada (n = %d):\n", $nobs
    printf "  media(rooms) = %.4f    varianza(rooms) = %.4f\n", mean(rooms), sum((rooms-mean(rooms))^2)/$nobs
    printf "  Sxx de estas %d viviendas (suma de cuadrados en desviaciones) = %.4f\n", $nobs, Sxx_obs
    printf "  Sxx esperado para %d viviendas sorteadas de la poblacion     = %.4f\n", $nobs, ($nobs-1)*var_rooms
    printf "\nVar[b2 | X] en estas %d viviendas (formula de la leccion 11) = %.1f   (error estandar %.1f)\n", $nobs, Var_b2_en_X_observada, sqrt(Var_b2_en_X_observada)
end outfile

scalar R = 4000

set seed 160
loop R --progressive --quiet
    series u = normal(0, sigma)
    series y = beta1_verdadero + beta2_verdadero*rooms + u      # rooms NO cambia
    ols y const rooms --quiet
    scalar b_fijo = $coeff(rooms)
    store "@workdir/repFijo.gdt" b_fijo
endloop
outfile --quiet avisoA.txt
    printf "Hecho: %d replicas con el regresor fijo guardadas en repFijo.gdt\n", R
end outfile

outfile --quiet unSorteoX.txt
    set seed 160
    matrix idx  = ceil(N * muniform(12,1))      # doce indices entre 1 y 506
    series xnew = pob_rooms[idx]                # doce viviendas de hprice2, con reemplazamiento
    printf "Sxx de las doce viviendas observadas = %.4f\n", Sxx_obs
    printf "Sxx de doce viviendas sorteadas       = %.4f\n", sum((xnew-mean(xnew))^2)
end outfile

set seed 160
loop R --progressive --quiet
    matrix idx  = ceil(N * muniform(12,1))      # doce indices entre 1 y 506
    series xnew = pob_rooms[idx]                # doce viviendas NUEVAS, de hprice2
    series u    = normal(0, sigma)
    series y    = beta1_verdadero + beta2_verdadero*xnew + u
    ols y const xnew --quiet
    scalar b_var = $coeff(xnew)
    scalar Sxx_i = sum((xnew-mean(xnew))^2)     # el Sxx de ESTA replica
    store "@workdir/repVar.gdt" b_var Sxx_i
endloop
outfile --quiet avisoB.txt
    printf "Hecho: %d replicas con regresor nuevo guardadas en repVar.gdt\n", R
end outfile

outfile --quiet comparacion.txt
    printf "=== LO QUE PREDICE LA LECCION 11 (condicional en la X observada) ===\n"
    printf "beta_2 verdadero  = %.2f\n", beta2_verdadero
    printf "Var[b2 | X]       = %.1f\n\n", Var_b2_en_X_observada
end outfile

open "@workdir/repFijo.gdt" --quiet
outfile --quiet comparacionA.txt
    printf "=== EXPERIMENTO A: regresor FIJO ===\n"
    printf "media de b2hat    = %.2f\n", mean(b_fijo)
    printf "varianza de b2hat = %.1f\n\n", sum((b_fijo-mean(b_fijo))^2)/$nobs
end outfile

open "@workdir/repVar.gdt" --quiet
outfile --quiet comparacionB.txt
    printf "=== EXPERIMENTO B: regresor REMUESTREADO en cada replica ===\n"
    printf "media de b2hat    = %.2f\n", mean(b_var)
    printf "varianza de b2hat = %.1f\n", sum((b_var-mean(b_var))^2)/$nobs
    printf "\nSxx a lo largo de las replicas del experimento B:\n"
    printf "  medio = %.4f    minimo = %.4f    maximo = %.4f\n", mean(Sxx_i), min(Sxx_i), max(Sxx_i)
end outfile

open hprice2.gdt --quiet
ols price const rooms --quiet
scalar beta1_verdadero = $coeff(const)
scalar beta2_verdadero = $coeff(rooms)
scalar sigma     = sqrt($ess/$df)
scalar var_rooms = sum((rooms-mean(rooms))^2)/$nobs

set seed 2
smpl 12 --random                        # OTRAS doce viviendas
scalar Sxx_obs2 = sum((rooms-mean(rooms))^2)
scalar Var_b2_en_X_observada2 = sigma^2 / Sxx_obs2
outfile --quiet otrasDoce.txt
    printf "Sxx de estas otras 12 viviendas = %.4f   (esperado %.4f; las doce de la Actividad 1: 3,2670)\n", Sxx_obs2, 11*var_rooms
    printf "Var[b2 | X] en estas 12 viviendas (formula de la leccion 11) = %.1f\n", Var_b2_en_X_observada2
end outfile

set seed 160
loop 4000 --progressive --quiet
    series u = normal(0, sigma)
    series y = beta1_verdadero + beta2_verdadero*rooms + u      # rooms NO cambia
    ols y const rooms --quiet
    scalar b_fijo2 = $coeff(rooms)
    store "@workdir/repFijo2.gdt" b_fijo2
endloop
open "@workdir/repFijo2.gdt" --quiet
outfile --quiet otrasDoceResultado.txt
    printf "=== EXPERIMENTO A con las otras doce viviendas: regresor FIJO ===\n"
    printf "media de b_fijo2    = %.2f\n", mean(b_fijo2)
    printf "varianza de b_fijo2 = %.1f\n", sum((b_fijo2-mean(b_fijo2))^2)/$nobs
end outfile

open hprice2.gdt --quiet
ols price const rooms --quiet
scalar beta1_verdadero = $coeff(const)
scalar beta2_verdadero = $coeff(rooms)
scalar sigma   = sqrt($ess/$df)
matrix pob_rooms = {rooms}
scalar N         = $nobs
scalar var_rooms = sum((rooms-mean(rooms))^2)/N

set seed 160
smpl 400 --random
scalar Sxx_obs  = sum((rooms-mean(rooms))^2)
scalar Var_b2_en_X_observada = sigma^2 / Sxx_obs

set seed 160
loop 40000 --progressive --quiet      # diez veces mas replicas que en la Actividad 2: ver el texto
    series u = normal(0, sigma)
    series y = beta1_verdadero + beta2_verdadero*rooms + u
    ols y const rooms --quiet
    scalar bg_fijo = $coeff(rooms)
    matrix idx  = ceil(N * muniform(400,1))
    series xnew = pob_rooms[idx]
    series u2   = normal(0, sigma)
    series y2   = beta1_verdadero + beta2_verdadero*xnew + u2
    ols y2 const xnew --quiet
    scalar bg_var = $coeff(xnew)
    store "@workdir/repGrande.gdt" bg_fijo bg_var
endloop

outfile --quiet muestraGrande.txt
    printf "Con n = 400:  Sxx observado = %.2f   (esperado: %.2f)\n", Sxx_obs, ($nobs-1)*var_rooms
    printf "             Var[b2|X] en las 400 viviendas observadas = %.2f\n", Var_b2_en_X_observada
    printf "             cociente Sxx observado/esperado = %.3f  <- lo que cabe esperar de var_B/var_A\n", Sxx_obs/(($nobs-1)*var_rooms)
end outfile

open "@workdir/repGrande.gdt" --quiet
outfile --quiet muestraGrandeResultado.txt
    printf "  regresor FIJO         : var = %.2f\n", sum((bg_fijo-mean(bg_fijo))^2)/$nobs
    printf "  regresor REMUESTREADO : var = %.2f\n", sum((bg_var-mean(bg_var))^2)/$nobs
    printf "  cociente observado    : %.3f\n", (sum((bg_var-mean(bg_var))^2))/(sum((bg_fijo-mean(bg_fijo))^2))
end outfile
